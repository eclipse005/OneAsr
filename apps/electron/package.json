{
  "name": "oneasr-electron",
  "version": "0.2.0",
  "description": "OneAsr modern Electron UI (replaces GPUI shell; reuses oneasr-cli)",
  "main": "./out/main/index.js",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "start": "electron .",
    "typecheck": "tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.node.json",
    "smoke:settings": "node scripts/smoke-settings.mjs",
    "smoke:transcribe": "node scripts/smoke-transcribe.mjs",
    "smoke:launch": "node scripts/launch-smoke.mjs",
    "shots": "node scripts/take-shots.mjs"
  },
  "dependencies": {
    "framer-motion": "^11.18.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.3.1",
    "electron-vite": "^2.3.0",
    "typescript": "^5.7.3",
    "vite": "^5.4.11"
  },
  "allowScripts": {
    "electron@33.4.11": true,
    "esbuild@0.21.5": true
  }
}
