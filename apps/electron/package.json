{
  "name": "oneasr-electron",
  "version": "1.3.0",
  "description": "OneAsr modern Electron UI (reuses oneasr-cli)",
  "author": "OneAsr",
  "main": "./out/main/index.js",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "start": "electron .",
    "typecheck": "tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.node.json",
    "smoke:settings": "node scripts/smoke-settings.mjs",
    "smoke:transcribe": "node scripts/smoke-transcribe.mjs",
    "smoke:launch": "node scripts/launch-smoke.mjs",
    "shots": "node scripts/take-shots.mjs",
    "test": "vitest run",
    "verify": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "framer-motion": "^11.18.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "44.9.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^2.3.0",
    "typescript": "^5.7.3",
    "unzipper": "^0.12.5",
    "vite": "^5.4.11",
    "vitest": "^2.1.9"
  },
  "allowScripts": {
    "electron@44.9.0": true,
    "esbuild@0.21.5": true
  }
}
