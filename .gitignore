/target
/runs
/output
# Bundled ffmpeg（约 60–100 MB）只本地存在，从不入库：Windows 用 bin/ffmpeg.exe，
# Linux/macOS 用无扩展名的 bin/ffmpeg。整个目录忽略、只放行占位文件，
# 免得哪天多出一个平台的文件就被误提交。
/bin/*
!/bin/.gitkeep
# Downloaded ASR/aligner weights (multi-GB; never commit)
/models
# CUDA DLLs installed next to the exe / into dll/
/dll
# User preferences (local machine paths)
/settings.json
# Usage ledger written next to settings.json (numbers only, per machine)
/stats.jsonl
# Crash/error log written next to the exe (rotated to .old)
/oneasr-error.log
/oneasr-error.log.old
# Release packaging output
/dist
/release
# Forum drafts stay local (any `forum-post*.md` variant)
/forum-post*.md
# Local scratch: visual pages, HTML mockups, ad-hoc output (never committed)
/tmp/
# Local tooling workspace: scratch files, notes, audition material (never committed)
/.workbuddy/
# Icon gen intermediates
assets/icons/_t*.png
# scripts/ 下的 Python 校验脚本运行时的字节码缓存
__pycache__/
*.pyc
**/*.rs.bk
.DS_Store
*.pdb
# Local evaluation audio (large; keep manifest/README in git if desired)
/testdata/clips/
/testdata/refs/
/testdata/gold/
/testdata/hyps/
/testdata/baselines/
/testdata/_cache/
/testdata/_compare*/
